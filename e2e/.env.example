# Copy to .env and fill in. Never commit .env.

# Which environment to hit: local | prod
TARGET=local

LOCAL_FRONTEND_URL=http://localhost:3000
LOCAL_BACKEND_URL=http://localhost:5000

PROD_FRONTEND_URL=https://YOUR_APP.vercel.app
PROD_BACKEND_URL=https://legalai-backend-XXXXXXXXXX-af.a.run.app

# Dedicated advocate-role test account (create with: npm run create-user)
TEST_EMAIL=e2e-advocate@legalai.test
TEST_PASSWORD=change-me-strong-password
TEST_USERNAME=e2e_advocate

# Only needed by scripts/create-test-user.mjs (local path, never deployed)
FIREBASE_SERVICE_ACCOUNT_PATH=../backend/legalai-scc-firebase-adminsdk-fbsvc-73bde27853.json

# The question used by the chat test
TEST_QUESTION=Is an M-Pesa statement admissible as evidence in the Small Claims Court?
