# Root-level .gcloudignore — build context = repo root
# Dockerfile (backend/Dockerfile) needs: backend/ and data/
# Everything else excluded to keep upload small.

# Top-level directories not needed for the Docker build
frontend/
e2e/
docs/
infra/
tests/
scripts/
eval/
legacy/
backups/
SCCImages/
hosting-public/
firestore-tests/
venv/

# Top-level files (note leading / = root-level only, not recursive)
/*.pdf
/*.zip
/*.ipynb
/*.txt
/*.md
/*.log
/*.sh
/*.db
/Makefile
/firebase.json
/firestore.rules
/firestore.indexes.json
/storage.rules
/pytest.ini
/deploy-log.md
/cloudbuild.yaml
/.gcloudignore
/.gitignore
/CRIMINAL-LAW-By-Musyoka.pdf
/StatutesPackaged.zip
/legalai-e2e.zip

# Backend exclusions (venv, caches, secrets, large backup dirs)
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/**/*.pyc
backend/.env
backend/debug_highlights/
backend/logs/
backend/backups/
backend/ChunkDB_backup_20261031/
backend/LegalSummariesDB.bak/
backend/constitutionlogic/MasterRulesDB.bak/
backend/constitutionlogic/MasterRulesDB_backup_20261031/
backend/Const_IntepretationLaws/
backend/legalai-scc-firebase-adminsdk-fbsvc-73bde27853.json
backend/legalai-service-account.json
backend/*.zip
backend/SCCases.zip
backend/caselaw.zip

# .git
.git/
