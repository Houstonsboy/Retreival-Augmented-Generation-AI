rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Evidence files uploaded by users from the browser.
    // Path: evidence/{uid}/{sha256}/{fileName}
    // - read: only the owning user (download URLs already contain a token,
    //   but the rule ensures no other authenticated user can access).
    // - write: owner only; max 15 MB; images and PDFs only.
    match /evidence/{uid}/{sha256}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
    }

    // Deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
