rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidUsername(u) {
      return u is string && u.size() >= 3 && u.size() <= 30 && u.matches('^[a-z0-9_]+$');
    }
    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }
    function usernamePath(u) {
      return /databases/$(database)/documents/usernames/$(u);
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['username', 'email', 'type', 'authProvider', 'advocateVerified', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['username', 'email', 'type', 'authProvider', 'advocateVerified', 'createdAt', 'updatedAt'])
        && request.resource.data.type == 'advocate'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.advocateVerified == false
        && request.resource.data.authProvider in ['password', 'google']
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && isValidUsername(request.resource.data.username)
        && existsAfter(usernamePath(request.resource.data.username))
        && getAfter(usernamePath(request.resource.data.username)).data.uid == uid;

      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && isValidUsername(request.resource.data.username)
        && existsAfter(usernamePath(request.resource.data.username))
        && getAfter(usernamePath(request.resource.data.username)).data.uid == uid;

      allow delete: if false;
    }

    match /usernames/{username} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && isValidUsername(username)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && existsAfter(userPath(request.auth.uid))
        && getAfter(userPath(request.auth.uid)).data.username == username;

      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.username != username;

      allow update: if false;
    }

    match /CaseLaws/{docId} {
      allow read: if request.auth != null;
      allow write: if false;  // writes go through the Admin SDK (Flask backend)
    }

    // Chat history — written exclusively by the backend Admin SDK.
    // Clients may read their own conversations and turns; all writes are denied.
    match /users/{uid}/conversations/{convId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;

      match /turns/{turnId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
